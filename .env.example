DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=troque_por_uma_senha_forte
DB_NAME=geo_mapa_app

# Máximo de áreas guardadas. Ao passar do limite, as mais antigas são removidas (padrão 300)
AREA_LIMIT=300

# Áreas mais antigas que isso são apagadas durante as gravações (padrão 7)
AREA_RETENTION_DAYS=7

# Gravações por hora por IP (padrão 10) e leituras por minuto por IP (padrão 300)
RATE_LIMIT_WRITES_PER_HOUR=10
RATE_LIMIT_READS_PER_MINUTE=300

# Segredo usado para gerar o hash dos IPs guardados no rate limit. Obrigatório em produção.
# Gere um valor aleatório longo e não o compartilhe.
RATE_LIMIT_SECRET=troque_por_um_segredo_longo

# Defina 1 atrás de um proxy confiável (Render), para usar X-Forwarded-For
TRUST_PROXY=0

# Arquivo com os termos bloqueados (padrão: moderation_terms.txt)
# MODERATION_TERMS_FILE=moderation_terms.txt
